{
  "spec": "polymorph-screen/1",
  "name": "OrderDetail",
  "purpose": "One customer's order in full: its status and facts, its history, the support team's comments and a guarded refund.",
  "inputs": [
    {
      "name": "order",
      "type": "Order",
      "doc": "The order. Display strings (placedAt, total, paymentMethod, shippingAddress, statusLabel) arrive already formatted."
    },
    {
      "name": "events",
      "type": "TimelineEvent[]",
      "doc": "Order events, newest first. Each title says what happened; detail says who did it. Time is pre-formatted."
    },
    {
      "name": "comments",
      "type": "TimelineEvent[]",
      "doc": "Support comments, newest first, mapped by the container: title is the author, time is how long ago, detail is the comment body."
    },
    { "name": "draft", "type": "string", "doc": "The comment being written." },
    { "name": "onDraftChange", "type": "(value: string) => void" },
    { "name": "onPostComment", "type": "() => void" },
    { "name": "onBack", "type": "() => void", "doc": "Returns to the list of orders." },
    { "name": "refundOpen", "type": "boolean" },
    { "name": "onRefundOpenChange", "type": "(open: boolean) => void" },
    {
      "name": "refundDescription",
      "type": "string",
      "doc": "States the amount being refunded and where it goes."
    },
    {
      "name": "refundConfirmLabel",
      "type": "string",
      "doc": "The confirm verb including the amount."
    },
    { "name": "onRefundConfirm", "type": "() => void | Promise<void>" }
  ],
  "types": { "./order": ["Order"], "@polymorph/react-ui": ["TimelineEvent"] },
  "root": {
    "component": "DetailPage",
    "props": {
      "title": { "$": "order.title" },
      "backLabel": "Back to orders",
      "onBack": { "$": "onBack" },
      "meta": {
        "component": "Badge",
        "props": { "tone": { "$": "order.statusTone" } },
        "children": [{ "$": "order.statusLabel" }]
      },
      "actions": {
        "component": "ConfirmDialog",
        "props": {
          "title": "Refund this order?",
          "description": { "$": "refundDescription" },
          "confirmLabel": { "$": "refundConfirmLabel" },
          "tone": "danger",
          "cancelLabel": "Cancel",
          "open": { "$": "refundOpen" },
          "onOpenChange": { "$": "onRefundOpenChange" },
          "onConfirm": { "$": "onRefundConfirm" },
          "trigger": {
            "component": "Button",
            "props": { "label": "Refund", "variant": "outline", "tone": "danger" }
          }
        }
      },
      "aside": {
        "component": "Card",
        "props": { "as": "section" },
        "children": [
          {
            "component": "Stack",
            "props": { "gap": 4 },
            "children": [
              { "component": "Heading", "props": { "level": 2 }, "children": ["Order details"] },
              {
                "component": "DescriptionList",
                "props": {
                  "items": [
                    { "$object": { "term": "Customer", "detail": { "$": "order.customer" } } },
                    { "$object": { "term": "Placed", "detail": { "$": "order.placedAt" } } },
                    { "$object": { "term": "Total", "detail": { "$": "order.total" } } },
                    {
                      "$object": {
                        "term": "Payment method",
                        "detail": { "$": "order.paymentMethod" }
                      }
                    },
                    {
                      "$object": {
                        "term": "Shipping address",
                        "detail": { "$": "order.shippingAddress" }
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "children": [
      {
        "component": "Stack",
        "props": { "gap": 6 },
        "children": [
          {
            "component": "Stack",
            "props": { "gap": 3 },
            "children": [
              { "component": "Heading", "props": { "level": 2 }, "children": ["History"] },
              {
                "component": "Timeline",
                "props": { "label": "Order history", "events": { "$": "events" } }
              }
            ]
          },
          {
            "component": "Stack",
            "props": { "gap": 3 },
            "children": [
              { "component": "Heading", "props": { "level": 2 }, "children": ["Comments"] },
              {
                "component": "Timeline",
                "props": { "label": "Support comments", "events": { "$": "comments" } }
              },
              {
                "component": "FormField",
                "props": { "label": "New comment" },
                "children": [
                  {
                    "component": "Textarea",
                    "props": {
                      "value": { "$": "draft" },
                      "onChange": { "$": "onDraftChange" },
                      "placeholder": "Write a comment for the support team",
                      "rows": 3
                    }
                  }
                ]
              },
              {
                "component": "Inline",
                "props": { "justify": "end" },
                "children": [
                  {
                    "component": "Button",
                    "props": {
                      "label": "Post comment",
                      "variant": "solid",
                      "tone": "accent",
                      "icon": "send",
                      "onClick": { "$": "onPostComment" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
