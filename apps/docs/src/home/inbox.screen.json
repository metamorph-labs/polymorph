{
  "spec": "polymorph-screen/1",
  "name": "Inbox",
  "purpose": "A support inbox: a search field and one primary action.",
  "inputs": [
    { "name": "query", "type": "string" },
    { "name": "onQueryChange", "type": "(value: string) => void" },
    { "name": "onNewTicket", "type": "() => void" }
  ],
  "root": {
    "component": "ListPage",
    "props": {
      "title": "Inbox",
      "emptyState": { "$object": { "title": "No tickets" } },
      "actions": {
        "component": "Button",
        "props": { "icon": "add", "label": "New ticket", "onClick": { "$": "onNewTicket" } }
      },
      "filters": {
        "component": "SearchInput",
        "props": { "value": { "$": "query" }, "onChange": { "$": "onQueryChange" } }
      }
    }
  }
}
