{
  "durationsMs": {
    "control": 140,
    "surface": 220,
    "overlay": 260
  },
  "exitRatio": 0.65,
  "easings": {
    "enter": [0.16, 1, 0.3, 1],
    "exit": [0.7, 0, 0.84, 0],
    "standard": [0.4, 0, 0.2, 1]
  },
  "temperaments": {
    "none": {
      "durationScale": 0,
      "distanceScale": 0,
      "pressScale": 1,
      "ambient": false
    },
    "subtle": {
      "durationScale": 0.8,
      "distanceScale": 0.75,
      "pressScale": 0.99,
      "ambient": true
    },
    "standard": {
      "durationScale": 1,
      "distanceScale": 1,
      "pressScale": 0.97,
      "ambient": true
    },
    "expressive": {
      "durationScale": 1.35,
      "distanceScale": 1.25,
      "pressScale": 0.95,
      "ambient": true
    }
  },
  "springs": {
    "subtle": {
      "default": {
        "stiffness": 300,
        "damping": 35,
        "mass": 1
      },
      "snappy": {
        "stiffness": 400,
        "damping": 38,
        "mass": 0.9
      },
      "gentle": {
        "stiffness": 200,
        "damping": 30,
        "mass": 1.1
      }
    },
    "standard": {
      "default": {
        "stiffness": 300,
        "damping": 30,
        "mass": 1
      },
      "snappy": {
        "stiffness": 400,
        "damping": 32,
        "mass": 0.9
      },
      "gentle": {
        "stiffness": 200,
        "damping": 26,
        "mass": 1.1
      }
    },
    "expressive": {
      "default": {
        "stiffness": 340,
        "damping": 26,
        "mass": 1
      },
      "snappy": {
        "stiffness": 480,
        "damping": 28,
        "mass": 0.9
      },
      "gentle": {
        "stiffness": 220,
        "damping": 22,
        "mass": 1.1
      }
    },
    "none": {
      "default": {
        "stiffness": 300,
        "damping": 30,
        "mass": 1
      },
      "snappy": {
        "stiffness": 400,
        "damping": 32,
        "mass": 0.9
      },
      "gentle": {
        "stiffness": 200,
        "damping": 26,
        "mass": 1.1
      }
    }
  },
  "scaleFrom": {
    "control": 0.9,
    "surface": 0.94,
    "overlay": 0.96
  },
  "distancesPx": {
    "sm": 4,
    "md": 8,
    "lg": 16
  },
  "ambientPeriodsMs": {
    "shimmer": 1600,
    "spin": 900
  },
  "pressFeedback": {
    "downDurationFactor": 0.5,
    "downEasing": "standard",
    "releaseSpring": "snappy",
    "cssReleaseFallbackEasing": "enter"
  },
  "patterns": {
    "fade": {
      "properties": ["opacity"],
      "from": {
        "opacity": 0
      },
      "durationClass": "binding",
      "enterEasing": "enter",
      "exitEasing": "exit",
      "reducedMotion": "self"
    },
    "scale-fade": {
      "properties": ["opacity", "transform"],
      "from": {
        "opacity": 0,
        "scale": "scaleFrom[class]"
      },
      "scaleFromFormula": "1 - (1 - scaleFrom[class]) * distanceScale",
      "originRules": {
        "anchored": "the trigger-facing edge, from Radix side/align data",
        "pointer-launched": "the trigger element's center, projected into the panel (fallback: center)",
        "default": "center"
      },
      "durationClass": "binding",
      "enterEasing": "enter",
      "exitEasing": "exit",
      "reducedMotion": "fade"
    },
    "slide-fade": {
      "properties": ["opacity", "transform"],
      "from": {
        "opacity": 0,
        "translate": "distancesPx[binding] * distanceScale"
      },
      "direction": "from the bound edge or side toward rest position",
      "defaultDistanceByClass": {
        "control": "sm",
        "surface": "md",
        "overlay": "lg"
      },
      "durationClass": "binding",
      "enterEasing": "enter",
      "exitEasing": "exit",
      "reducedMotion": "fade"
    },
    "collapse": {
      "properties": ["block-size | inline-size", "opacity (content)"],
      "modes": {
        "persistent": {
          "use": "regions that stay mounted (sidebar rail)",
          "sizeEasing": "standard",
          "sizeDurationClass": "surface",
          "contentFade": "text/labels fade out over first 0.5 of duration before size moves inward; fade in over last 0.5 when expanding"
        },
        "exit": {
          "use": "unmount choreography (toast leaving a stack)",
          "sizeEasing": "exit",
          "sizeDurationClass": "surfaceExit",
          "contentFade": "content opacity to 0 over first 0.5, then size to 0 over remaining 0.5"
        }
      },
      "overflow": "hidden while animating",
      "reducedMotion": "instant size change; content uses fade"
    },
    "spring-pop": {
      "properties": ["opacity", "transform"],
      "from": {
        "opacity": 0,
        "scale": 0.5
      },
      "scaleSpring": "snappy",
      "opacity": "0 to 1 over control * 0.5, easing standard",
      "exit": "fade at controlExit (pops never un-pop)",
      "reducedMotion": "fade"
    },
    "shimmer": {
      "ambient": true,
      "properties": ["transform (gradient layer)"],
      "loop": "translateX -100% to 100% of a 200%-wide gradient overlay, linear, infinite",
      "periodMsRef": "ambientPeriodsMs.shimmer / durationScale",
      "reducedMotion": "off (static base fill)"
    },
    "spin": {
      "ambient": true,
      "properties": ["transform"],
      "loop": "rotate 0 to 360deg, linear, infinite",
      "periodMsRef": "ambientPeriodsMs.spin / durationScale",
      "reducedMotion": "off (static glyph)"
    },
    "sheet": {
      "properties": ["transform"],
      "from": {
        "translate": "100% on the bound edge"
      },
      "opacity": "1 throughout \u2014 a sheet is pushed in, it does not fade in",
      "distance": "structural: 100% of the panel's own size. distanceScale does NOT apply \u2014 the first pattern where distance is geometry rather than travel budget",
      "edge": "the panel's own edge, logical: start | end | bottom (no top \u2014 Toast owns arrival from above)",
      "durationClass": "binding",
      "enterEasing": "enter",
      "exitEasing": "exit",
      "reducedMotion": "fade in place \u2014 no travel"
    }
  },
  "bindings": {
    "dialog.scrim": {
      "pattern": "fade",
      "class": "overlay"
    },
    "dialog.panel": {
      "pattern": "scale-fade",
      "class": "overlay",
      "origin": "pointer-launched"
    },
    "select.content": {
      "pattern": "scale-fade",
      "class": "surface",
      "origin": "anchored"
    },
    "tooltip.bubble": {
      "pattern": "scale-fade",
      "class": "control",
      "origin": "anchored"
    },
    "toast.enter": {
      "pattern": "slide-fade",
      "class": "surface",
      "distance": "lg",
      "edge": "bottom",
      "spring": "default"
    },
    "toast.exit": {
      "pattern": "collapse",
      "mode": "exit",
      "plus": "fade"
    },
    "toast.reflow": {
      "spring": "default",
      "properties": ["transform (y)"]
    },
    "checkbox.indicator": {
      "pattern": "spring-pop"
    },
    "switch.thumb": {
      "spring": "snappy",
      "properties": ["transform (x)"]
    },
    "button.press": {
      "pattern": "press-feedback"
    },
    "button.spinner": {
      "pattern": "spin"
    },
    "input.clear": {
      "pattern": "fade",
      "class": "control"
    },
    "formfield.error": {
      "pattern": "slide-fade",
      "class": "control",
      "distance": "sm",
      "edge": "top"
    },
    "skeleton.sheen": {
      "pattern": "shimmer"
    },
    "appshell.sidebar": {
      "pattern": "collapse",
      "mode": "persistent",
      "axis": "inline"
    },
    "listpage.bodyswap": {
      "pattern": "fade",
      "class": "surface"
    },
    "emptystate.enter": {
      "pattern": "fade",
      "class": "surface"
    },
    "table.sorticon": {
      "pattern": "fade",
      "class": "control"
    },
    "select.chevron": {
      "properties": ["transform (rotate 180deg)"],
      "class": "control",
      "easing": "standard"
    },
    "menu.content": {
      "pattern": "scale-fade",
      "class": "surface",
      "origin": "anchored"
    },
    "popover.panel": {
      "pattern": "scale-fade",
      "class": "surface",
      "origin": "anchored"
    },
    "tabs.indicator": {
      "spring": "default",
      "properties": [
        "transform (x, scaleX) horizontal; transform (y, scaleY) vertical — one binding, axis by orientation"
      ]
    },
    "tabs.content": {
      "pattern": "fade",
      "class": "surface"
    },
    "progress.fill": {
      "properties": ["transform (scaleX)"],
      "class": "surface",
      "easing": "standard"
    },
    "avatar.image": {
      "pattern": "fade",
      "class": "control"
    },
    "radio.indicator": {
      "pattern": "spring-pop"
    },
    "datatable.bulkbar": {
      "pattern": "slide-fade",
      "class": "control",
      "distance": "sm",
      "edge": "top",
      "enterOnly": "the bar leaves with the selection, and animating its exit delays the table's return"
    },
    "filterbar.clear": {
      "pattern": "fade",
      "class": "control"
    },
    "spinner.glyph": {
      "pattern": "spin"
    },
    "accordion.content": {
      "pattern": "collapse",
      "mode": "persistent"
    },
    "collapsible.content": {
      "pattern": "collapse",
      "mode": "persistent"
    },
    "drawer.panel": {
      "pattern": "sheet",
      "class": "overlay"
    },
    "sheet.panel": {
      "pattern": "sheet",
      "class": "overlay"
    },
    "alert.dismiss": {
      "pattern": "collapse",
      "mode": "exit"
    },
    "stepper.indicator": {
      "pattern": "spring-pop"
    },
    "slider.thumb": {
      "spring": "snappy",
      "properties": ["transform (scale 1.12)"]
    },
    "taginput.chip": {
      "pattern": "scale-fade",
      "class": "control",
      "exit": "fade"
    },
    "taginput.reflow": {
      "spring": "default",
      "properties": ["transform (x, y)"]
    },
    "fileupload.row": {
      "pattern": "slide-fade",
      "class": "control",
      "distance": "sm",
      "edge": "top",
      "exit": "fade"
    },
    "fileupload.reflow": {
      "spring": "default",
      "properties": ["transform (y)"]
    },
    "combobox.popup": {
      "pattern": "scale-fade",
      "class": "surface",
      "origin": "anchored"
    },
    "combobox.glyph": {
      "pattern": "fade",
      "class": "control"
    },
    "datepicker.popup": {
      "pattern": "scale-fade",
      "class": "surface",
      "origin": "anchored"
    },
    "calendar.month": {
      "pattern": "slide-fade",
      "class": "surface",
      "distance": "sm",
      "direction": "the month's travel \u2014 next enters from the inline end, previous from the start, mirrored under RTL. Resolved by the CSS leg, which is why no fixed `edge` is named here",
      "enterOnly": "the outgoing grid is replaced in place rather than dismissed. Cross-fading it would need both months mounted and out of flow, and a 4-week month and a 6-week month are different heights"
    },
    "command.panel": {
      "pattern": "scale-fade",
      "class": "overlay",
      "origin": "anchored"
    },
    "scrollarea.rail": {
      "pattern": "fade",
      "class": "control"
    },
    "chart.frame": {
      "pattern": "fade",
      "class": "surface",
      "easing": "enter"
    },
    "chat.message": {
      "pattern": "slide-fade",
      "class": "control",
      "distance": "sm",
      "edge": "bottom",
      "enterOnly": "a turn arrives from the composer's edge and is never taken back — a message leaving a thread would be the thread rewriting history"
    },
    "streaming.pending": {
      "pattern": "shimmer"
    },
    "toolcall.status": {
      "pattern": "fade",
      "class": "control"
    },
    "chart.marks": {
      "properties": ["transform", "opacity"],
      "class": "surface",
      "easing": "enter",
      "stagger": "step/max",
      "entrance": "transform from the baseline — bars scaleY from the zero line (the Progress inline-transform precedent: geometry is data, not a decision); strokes and washes take opacity",
      "noDrawOn": "`stroke-dashoffset` would need a new pattern kind for a flourish the restraint law already answers — data is not playful",
      "dataChange": "value changes re-render; refetch dims via data-state=\"loading\" opacity at the surface duration",
      "reducedMotion": "everything snaps; the stagger dies globally as it already does"
    }
  }
}
