{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/angular-ui-node.tsbuildinfo",
    // The node files at this package's root, and nothing else. Separate from
    // `tsconfig.json` so the vocabulary itself keeps `"types": []`. DOM is here for
    // `@polymorph/theme`'s runtime, which the laws reach through the engine.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["*.test.ts", "dist-lock.ts", "vitest.plugins.ts"]
}
