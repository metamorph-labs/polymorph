{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/mcp.tsbuildinfo",
    // DOM for the same reason as the registry's and the CLI's: importing the
    // engine as workspace source pulls in `@polymorph/theme`'s `runtime.ts`.
    // Nothing in the server touches a DOM — every test here is a node test.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "*.test.ts"]
}
