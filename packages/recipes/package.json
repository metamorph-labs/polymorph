{
  "name": "@polymorph/recipes",
  "version": "1.0.18",
  "description": "The Polymorph design system's styles, the recipes: every component's styling as a token-only CSS Module, with no framework in it, and the base layer.",
  "keywords": [
    "polymorph",
    "design-system",
    "css",
    "css-modules",
    "design-tokens",
    "components",
    "styles"
  ],
  "private": true,
  "exports": {
    "./base.css": "./src/base.css",
    "./*.module.css": "./src/*.module.css"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "license": "MIT"
}
