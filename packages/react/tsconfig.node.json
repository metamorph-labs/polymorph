{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/react-node.tsbuildinfo",
    // The node files at this package's root, and nothing else. Separate from
    // `tsconfig.json` so the React foundation keeps `"types": []`: its source
    // must typecheck without node's globals in scope, and one config for both
    // would quietly hand them over.
    "types": ["node"]
  },
  "include": ["*.test.ts", "dist-lock.ts", "vite.config.ts"]
}
