{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Types only. Vite emits the JavaScript (`vite.config.ts`). No declaration
    // maps: the tarball ships no source for one to point at.
    //
    // Straight into `dist/types`, with nothing to flatten. Every input is under
    // `src/`, and the engine is a published dependency, so a declaration names
    // `@polymorph/engine` and the consumer resolves it from their own install.
    // `rootDir` holds that: a source file that read `design/` would put an input
    // outside `src/`, and the build would fail instead of shipping a declaration
    // that imports a file no consumer has.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist/types",

    // Not the typecheck's cache file. A `.tsbuildinfo` from `tsconfig.json`'s
    // `--noEmit` run would tell this program its declarations are up to date,
    // so tsc would emit nothing after Vite emptied `dist/`.
    "incremental": false,
    "tsBuildInfoFile": null
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
