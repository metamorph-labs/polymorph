{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/spec.tsbuildinfo",
    // DOM for the same reason as the registry's: importing the engine as
    // workspace source pulls in `@polymorph/theme`'s `runtime.ts`. Nothing here
    // touches a DOM — the emitter writes text.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "*.test.ts"]
}
