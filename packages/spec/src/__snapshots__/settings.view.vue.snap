<script setup lang="ts">
/**
 * Relay's settings screen — appearance and notifications, as two labelled groups.
 *
 * Emitted from a screen spec (`polymorph-screen/1`). Composition and bindings only:
 * this file holds no state, computes nothing, and expresses no style — the
 * container that renders it owns all three.
 */
import { Checkbox, Select, SettingsPage, SettingsRow, Switch } from '@polymorph/vue-ui'

export interface SettingsViewProps {
  /** The system currently worn. */
  system: string | null
  onSystemChange: (value: string | null) => void
  /** The palette painting it. */
  palette: string | null
  onPaletteChange: (value: string | null) => void
  /** The stored preference, which may be `system`. */
  mode: string
  onModeChange: (value: string | null) => void
  density: string | null
  onDensityChange: (value: string | null) => void
  motion: string
  onMotionChange: (value: string | null) => void
  systemOptions: { value: string; label: string }[]
  paletteOptions: { value: string; label: string }[]
  modeOptions: { value: string; label: string }[]
  densityOptions: { value: string; label: string }[]
  motionOptions: { value: string; label: string }[]
  digest: boolean
  onDigestChange: (next: boolean) => void
  signature: boolean
  onSignatureChange: (next: boolean | 'indeterminate') => void
}

const props = defineProps<SettingsViewProps>()
</script>

<template>
  <SettingsPage
    title="Settings"
    description="Appearance applies to every screen in Relay the moment it changes."
  >
    <SettingsRow.Group title="Appearance">
      <SettingsRow label="System" description="Type, shape and spacing — how the product is built.">
        <template #control>
          <Select
            :options="props.systemOptions"
            :value="props.system"
            @change="props.onSystemChange"
          />
        </template>
      </SettingsRow>
      <SettingsRow
        label="Palette"
        description="The colour it is painted with. Any palette, any system."
      >
        <template #control>
          <Select
            :options="props.paletteOptions"
            :value="props.palette"
            @change="props.onPaletteChange"
          />
        </template>
      </SettingsRow>
      <SettingsRow label="Mode" description="Follow the operating system, or pin one.">
        <template #control>
          <Select :options="props.modeOptions" :value="props.mode" @change="props.onModeChange" />
        </template>
      </SettingsRow>
      <SettingsRow label="Density" description="Space and control sizes. Never the type scale.">
        <template #control>
          <Select
            :options="props.densityOptions"
            emptyOption="theme default"
            :value="props.density"
            @change="props.onDensityChange"
          />
        </template>
      </SettingsRow>
      <SettingsRow
        label="Motion"
        description="How much the interface moves. None is a full stop, not a slower version."
      >
        <template #control>
          <Select
            :options="props.motionOptions"
            :value="props.motion"
            @change="props.onMotionChange"
          />
        </template>
      </SettingsRow>
    </SettingsRow.Group>
    <SettingsRow.Group title="Notifications">
      <SettingsRow
        label="Daily digest"
        description="One summary each morning instead of a notification per reply."
      >
        <template #control>
          <Switch :checked="props.digest" @checkedChange="props.onDigestChange" />
        </template>
      </SettingsRow>
      <SettingsRow
        label="Append my signature"
        description="Added to the end of every reply you send."
      >
        <template #control>
          <Checkbox :checked="props.signature" @checkedChange="props.onSignatureChange" />
        </template>
      </SettingsRow>
    </SettingsRow.Group>
  </SettingsPage>
</template>
