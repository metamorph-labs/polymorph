// Emitted from a screen spec (`polymorph-screen/1`): `SettingsView`, for iOS. The view is the
// spec's tree and nothing more: it holds no state, calls nothing asynchronous and navigates
// nowhere. The app renders it from a store that owns the model, its tasks and its router, and
// supplies the actions (`design/native/screen-contract.md`).

import PolymorphUI
import SwiftUI

/// What `SettingsView` shows. `loadStatus` says which of the four load states it is in.
struct SettingsModel {
  var loadStatus: PMLoadStatus
  /// The system currently worn.
  var system: String?
  /// The palette painting it.
  var palette: String?
  /// The stored preference, which may be `system`.
  var mode: String
  var density: String?
  var motion: String
  var systemOptions: [PMSelectOptionEntry]
  var paletteOptions: [PMSelectOptionEntry]
  var modeOptions: [PMSelectOptionEntry]
  var densityOptions: [PMSelectOptionEntry]
  var motionOptions: [PMSelectOptionEntry]
  var digest: Bool
  var signature: PMCheckedState
}

/// The code the app supplies to `SettingsView`, one closure per action.
struct SettingsActions {
  let onSystemChange: @MainActor (String?) -> Void
  let onPaletteChange: @MainActor (String?) -> Void
  let onModeChange: @MainActor (String?) -> Void
  let onDensityChange: @MainActor (String?) -> Void
  let onMotionChange: @MainActor (String?) -> Void
  let onDigestChange: @MainActor (Bool) -> Void
  let onSignatureChange: @MainActor (PMCheckedState) -> Void
}

/// Relay's settings screen — appearance and notifications, as two labelled groups.
@MainActor
struct SettingsView: View {
  let model: SettingsModel
  let actions: SettingsActions

  var body: some View {
    PMSettingsPage(
      props: .init(
        loadStatus: model.loadStatus,
        children: AnyView(
          Group {
            PMSettingsRow.Group(
              props: .init(
                children: AnyView(
                  Group {
                    PMSettingsRow(
                      props: .init(
                        control: AnyView(
                          PMSelect(
                            props: .init(
                              onChange: actions.onSystemChange,
                              options: model.systemOptions,
                              value: .some(model.system)
                            )
                          )
                        ),
                        description: "Type, shape and spacing — how the product is built.",
                        label: "System"
                      )
                    )
                    PMSettingsRow(
                      props: .init(
                        control: AnyView(
                          PMSelect(
                            props: .init(
                              onChange: actions.onPaletteChange,
                              options: model.paletteOptions,
                              value: .some(model.palette)
                            )
                          )
                        ),
                        description: "The colour it is painted with. Any palette, any system.",
                        label: "Palette"
                      )
                    )
                    PMSettingsRow(
                      props: .init(
                        control: AnyView(
                          PMSelect(
                            props: .init(
                              onChange: actions.onModeChange,
                              options: model.modeOptions,
                              value: .some(model.mode)
                            )
                          )
                        ),
                        description: "Follow the operating system, or pin one.",
                        label: "Mode"
                      )
                    )
                    PMSettingsRow(
                      props: .init(
                        control: AnyView(
                          PMSelect(
                            props: .init(
                              emptyOption: "theme default",
                              onChange: actions.onDensityChange,
                              options: model.densityOptions,
                              value: .some(model.density)
                            )
                          )
                        ),
                        description: "Space and control sizes. Never the type scale.",
                        label: "Density"
                      )
                    )
                    PMSettingsRow(
                      props: .init(
                        control: AnyView(
                          PMSelect(
                            props: .init(
                              onChange: actions.onMotionChange,
                              options: model.motionOptions,
                              value: .some(model.motion)
                            )
                          )
                        ),
                        description: "How much the interface moves. None is a full stop, not a slower version.",
                        label: "Motion"
                      )
                    )
                  }
                ),
                title: "Appearance"
              )
            )
            PMSettingsRow.Group(
              props: .init(
                children: AnyView(
                  Group {
                    PMSettingsRow(
                      props: .init(
                        control: AnyView(
                          PMSwitch(
                            props: .init(
                              checked: model.digest,
                              onCheckedChange: actions.onDigestChange
                            )
                          )
                        ),
                        description: "One summary each morning instead of a notification per reply.",
                        label: "Daily digest"
                      )
                    )
                    PMSettingsRow(
                      props: .init(
                        control: AnyView(
                          PMCheckbox(
                            props: .init(
                              checked: model.signature,
                              onCheckedChange: actions.onSignatureChange
                            )
                          )
                        ),
                        description: "Added to the end of every reply you send.",
                        label: "Append my signature"
                      )
                    )
                  }
                ),
                title: "Notifications"
              )
            )
          }
        ),
        description: "Appearance applies to every screen in Relay the moment it changes.",
        title: "Settings"
      )
    )
  }
}

extension SettingsActions {
  /// Every action doing nothing, so an app compiles against the view before it wires its store. An
  /// action that answers returns the empty value of its result.
  @MainActor static let inert: Self = Self(
    onSystemChange: { _ in },
    onPaletteChange: { _ in },
    onModeChange: { _ in },
    onDensityChange: { _ in },
    onMotionChange: { _ in },
    onDigestChange: { _ in },
    onSignatureChange: { _ in }
  )
}
