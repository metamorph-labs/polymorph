{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Types only: Vite emits the JavaScript (`vite.build.config.ts`).
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    // No declaration maps: the tarball ships `dist` without `src`.
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist/types",
    // Its own buildinfo, so the typecheck's `--noEmit` cache never convinces
    // this program its declarations are already written.
    "incremental": false,
    "tsBuildInfoFile": null
  },
  // The laws, the fixtures, the galleries, the mount helper and the server-render law's own
  // entries are test tooling, not the published surface.
  "exclude": [
    "server-render.cases.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.states.tsx",
    "src/test-setup.ts",
    "src/mount.ts",
    "src/galleries.ts",
    "src/conformance/**"
  ]
}
