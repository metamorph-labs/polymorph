{
  "name": "@polymorph/svelte",
  "version": "1.0.16",
  "description": "The Svelte foundation of the Polymorph design system, which a consumer installs: the engine re-exported, the icon gateway, the motion presence, the control ref, the toast store and the page-transition convention. Svelte members import this and nothing deeper.",
  "keywords": [
    "polymorph",
    "design-system",
    "svelte",
    "svelte5",
    "ui",
    "theming",
    "design-tokens",
    "icons",
    "motion"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./motion": {
      "types": "./src/motion/index.ts",
      "svelte": "./src/motion/index.ts",
      "default": "./src/motion/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/package.mjs ."
  },
  "dependencies": {
    "@polymorph/engine": "workspace:*",
    "@zag-js/types": "^1.46.0"
  },
  "peerDependencies": {
    "svelte": "^5.46.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte2tsx": "^0.7.61",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./motion": {
        "types": "./dist/motion/index.d.ts",
        "svelte": "./dist/motion/index.js",
        "default": "./dist/motion/index.js"
      }
    }
  }
}
