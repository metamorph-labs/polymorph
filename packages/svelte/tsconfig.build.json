{
  "extends": "./tsconfig.json",
  // Declarations only, emitted by `svelte2tsx` (`scripts/package.mjs`).
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"],
  "exclude": ["src/**/*.test.ts"]
}
