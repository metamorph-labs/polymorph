{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The source a consumer's Solid compiles (the `solid` export condition): TypeScript removed,
    // JSX kept, so the consumer's compiler writes it for the browser, a server or hydration.
    "noEmit": false,
    "declaration": false,
    "rootDir": "src",
    "outDir": "dist/source",
    "incremental": false,
    "tsBuildInfoFile": null
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
