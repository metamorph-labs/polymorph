{
  "extends": "./tsconfig.json",
  // Declarations only, emitted by `svelte2tsx` (`../svelte/scripts/package.mjs`). The laws, the
  // fixtures, the galleries and the mount helper are test tooling, not the published surface.
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.states.svelte",
    "src/test-setup.ts",
    "src/mount.ts",
    "src/MountedEntry.svelte",
    "src/galleries.ts",
    "src/conformance/**",
    "src/testing/**"
  ]
}
