exports[`the exceptions seam > matches its snapshot 1`] = `
"@scope ([data-system="example-quiet"][data-palette="example-violet"]) to ([data-system][data-palette]) {
  [data-member="button"] {
    --pm-radius-control: var(--pm-radius-pill);
    --pm-shadow-seat: var(--pm-shadow-overlay);
  }
  [data-member="menu"] {
    --pm-inset-list: var(--pm-space-4);
  }
}
"
`;
